{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "vz:portalv2",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/circlepattern"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 4, 0],
				"radius": 0.25,
				"direction": [0, 0, 1]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.2,1)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(180,-180)",
				"rotation_rate": -360
			},
			"minecraft:particle_initial_speed": 0.2,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["(variable.particle_random_3 * 2 + 0.00) + (variable.particle_age * 3)", "(variable.particle_random_3 * 2 + 0.00) + (variable.particle_age * 3)"],
				"facing_camera_mode": "direction_z",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#9EFF0000",
						"0.28": "#4DFF2FA8",
						"1.0": "#00FF0000"
					}
				}
			}
		}
